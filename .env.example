APP_NAME=Sakura Football Model API
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1
POSTGRES_DB=football_model
POSTGRES_USER=football_model
POSTGRES_PASSWORD=change-me-before-production
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql+psycopg://football_model:change-me-before-production@db:5432/football_model
REDIS_URL=redis://redis:6379/0

# API-Football v3. Keep this value local only; never commit a real key.
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Optional in local development; required for protected production access.
ADMIN_API_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
PROVIDER_TIMEOUT_SECONDS=20
PROVIDER_MAX_RETRIES=3
PROVIDER_RETRY_BACKOFF_SECONDS=0.5
TARGET_SEASON=2026
API_FOOTBALL_PLAN_MODE=auto
API_FOOTBALL_DAILY_SOFT_LIMIT=80
API_FOOTBALL_DAILY_RESERVE=20
API_FOOTBALL_MIN_REMAINING_FOR_OPTIONAL=30
API_FOOTBALL_MIN_REMAINING_FOR_LINEUP=10
FOOTBALL_DATA_MODE=hybrid
PROVIDER_STATUS_CACHE_HOURS=24
PROVIDER_COVERAGE_CACHE_DAYS=7

# HTML/CSS poster PNG output directory. Keep generated images out of source control.
POSTER_OUTPUT_DIR=generated/posters
