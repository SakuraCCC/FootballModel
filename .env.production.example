APP_ENV=production
DEBUG=false
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
LOG_FORMAT=json
NGINX_PORT=80

POSTGRES_DB=football_model
POSTGRES_USER=football_model
POSTGRES_PASSWORD=replace-with-a-long-unique-password
DATABASE_URL=postgresql+psycopg://football_model:replace-with-a-long-unique-password@db:5432/football_model
REDIS_URL=redis://redis:6379/0

API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

POSTER_OUTPUT_DIR=/app/generated/posters
TEMPORARY_FILE_DIR=/app/generated/tmp
BACKUP_DIR=/var/backups/sakura-football

ADMIN_API_KEY=replace-with-a-long-random-admin-key
CORS_ALLOWED_ORIGINS=https://your-admin-domain.example
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
PROVIDER_TIMEOUT_SECONDS=20
PROVIDER_MAX_RETRIES=3
PROVIDER_RETRY_BACKOFF_SECONDS=0.5
TARGET_SEASON=2026
